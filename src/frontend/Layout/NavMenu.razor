        <div class="nav-section-title px-3">Tools</div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="test">
                <span class="bi bi-tools-nav-menu" aria-hidden="true"></span> Diagnostics
            </NavLink>
