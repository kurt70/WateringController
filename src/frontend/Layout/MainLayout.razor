@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject WateringHubClient HubClient
@inject ILogger<MainLayout> Logger
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <div class="top-row__panel">
                <div class="top-row__identity">
                    <div class="top-row__eyebrow">Watering Controller</div>
                    <div class="top-row__title">Control center</div>
                </div>
                <div class="top-row__summary">
                    Monitor live reservoir status, send manual pump commands, and keep recurring watering windows aligned.
                </div>
            </div>
            <div class="top-row__status">
                <span class="status-chip @(HubClient.IsConnected ? "ok" : "warn")">
                    @(HubClient.IsConnected ? "Live updates connected" : "Live updates reconnecting")
                </span>
                <span class="top-row__status-note">Backend-served dashboard</span>
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        HubClient.ConnectionStateChanged += HandleConnectionStateChanged;

        try
        {
            await HubClient.StartAsync();
        }
        catch (Exception ex)
        {
            // SignalR may be temporarily unavailable during startup; pages use HTTP fallbacks.
            Logger.LogWarning(ex, "SignalR startup failed in layout initialization.");
        }
    }

    private void HandleConnectionStateChanged(bool isConnected)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        HubClient.ConnectionStateChanged -= HandleConnectionStateChanged;
        await HubClient.StopAsync();
    }
}
